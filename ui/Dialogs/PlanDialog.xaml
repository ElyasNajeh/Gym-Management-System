<Window x:Class="GymManagementSystem.UI.Dialogs.PlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subscription plan"
        Width="490"
        Height="550"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Add subscription plan" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Create a clear offer for your gym members."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="PLAN NAME" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameTextBox" MaxLength="60" />

            <TextBlock Text="PRICE" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" />
            <TextBox x:Name="PriceTextBox" MaxLength="8" />
            <TextBlock Text="Plan prices must be between 100 and 1,000."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,6,0,0" />

            <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" />
            <TextBox x:Name="DescriptionTextBox"
                     Height="86"
                     MaxLength="220"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />

            <Border x:Name="ErrorPanel" Background="#FDEFF1" CornerRadius="7" Padding="10" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Add plan" Style="{StaticResource PrimaryButton}" Width="115" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
