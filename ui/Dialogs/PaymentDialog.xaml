<Window x:Class="GymManagementSystem.UI.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment"
        Width="520"
        Height="490"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Record payment" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Complete payment for an unpaid subscription."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <TextBlock Text="SUBSCRIPTION" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="SubscriptionComboBox"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="SubscriptionComboBox_SelectionChanged" />

            <Border Background="#F7F8FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,10,0,0">
                <Grid>
                    <TextBlock Text="Amount due" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="AmountText" Text="—" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <TextBlock Text="PAYMENT METHOD" Style="{StaticResource FieldLabel}" Margin="0,19,0,7" />
            <ComboBox x:Name="MethodComboBox" DisplayMemberPath="Name" />

            <Border Background="#EEEEFF" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,1,10,0" />
                    <TextBlock Text="Each subscription can be paid once. No external gateway is contacted."
                               Foreground="#4A4B9B" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Background="#FDEFF1" CornerRadius="7" Padding="10" Margin="0,13,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Record payment" Style="{StaticResource PrimaryButton}" Width="145" Click="RecordButton_Click" />
        </StackPanel>
    </Grid>
</Window>
