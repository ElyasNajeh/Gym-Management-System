<Window x:Class="GymManagementSystem.UI.Dialogs.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New subscription"
        Width="500"
        Height="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Create subscription" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Connect an existing member with an available plan."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <TextBlock Text="MEMBER" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="MemberComboBox" DisplayMemberPath="Name" />

            <TextBlock Text="SUBSCRIPTION PLAN" Style="{StaticResource FieldLabel}" Margin="0,19,0,7" />
            <ComboBox x:Name="PlanComboBox" DisplayMemberPath="Name" />

            <Border Background="#EEEEFF" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,1,10,0" />
                    <TextBlock Text="Subscriptions begin today and remain active for one year."
                               Foreground="#4A4B9B" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Background="#FDEFF1" CornerRadius="7" Padding="10" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Create subscription" Style="{StaticResource PrimaryButton}" Width="155" Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
