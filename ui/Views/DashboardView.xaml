<UserControl x:Class="GymManagementSystem.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Good to see you" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Here is a live overview of this gym session."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#E9F7F1"
                        CornerRadius="18"
                        Padding="13,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="System ready" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,28,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20">
                    <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#EEEEFF" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="MembersCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,15,0,2" />
                        <TextBlock Text="Total members" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,6,0" Padding="20">
                    <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#FFF4E6" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#DE8B22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PlansCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,15,0,2" />
                        <TextBlock Text="Available plans" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,4,0" Padding="20">
                    <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#E9F7F1" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="SubscriptionsCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,15,0,2" />
                        <TextBlock Text="Active subscriptions" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="20">
                    <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#FDEFF1" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#D8495B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="RevenueTotal" Text="$0.00" FontSize="28" FontWeight="SemiBold" Margin="0,15,0,2" />
                        <TextBlock Text="Recorded payments" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Getting started" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="A simple path to your first completed membership"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#EEEEFF">
                                <TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Create a member" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Add contact and fitness details." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FFF4E6">
                                <TextBlock Text="2" Foreground="#C97916" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Choose a plan" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Set up a plan, then assign it as a subscription." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#E9F7F1">
                                <TextBlock Text="3" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Record payment" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Select the subscription and payment method." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Session details" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Current local workspace status" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" />
                        <Grid Margin="0,0,0,13">
                            <TextBlock Text="Payments" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="PaymentCount" Text="0" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <Separator Background="{StaticResource BorderBrush}" />
                        <Grid Margin="0,13,0,13">
                            <TextBlock Text="Storage" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="In memory" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <Separator Background="{StaticResource BorderBrush}" />
                        <Grid Margin="0,13,0,0">
                            <TextBlock Text="Subscription term" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="1 year" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
