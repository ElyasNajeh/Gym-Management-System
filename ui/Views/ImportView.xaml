<UserControl x:Class="GymManagementSystem.UI.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Import data" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Preview and validate members or plans from Excel and tab-separated text files."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#FFF4E6"
                    CornerRadius="18"
                    Padding="13,7">
                <TextBlock Text="In-memory session only" Foreground="#B66E13" FontWeight="SemiBold" FontSize="11" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,24,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DATA TYPE" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DataTypeComboBox" SelectionChanged="DataTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Members" Tag="Members" />
                        <ComboBoxItem Content="Subscription plans" Tag="SubscriptionPlans" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SELECTED FILE" Style="{StaticResource FieldLabel}" />
                    <Border Height="40" Background="#F8F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                <TextBlock x:Name="FileNameText" Text="No file selected" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="FileDetailText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#939AAD" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Button x:Name="ChooseFileButton"
                        Grid.Column="4"
                        Content="Choose file"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Width="115"
                        Click="ChooseFileButton_Click" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                <StackPanel><TextBlock x:Name="TotalCountText" Text="0" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Total" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                <StackPanel><TextBlock x:Name="ValidCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" /><TextBlock Text="Valid" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                <StackPanel><TextBlock x:Name="InvalidCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" /><TextBlock Text="Invalid" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                <StackPanel><TextBlock x:Name="DuplicateCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#DE8B22" /><TextBlock Text="Duplicates" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                <StackPanel><TextBlock x:Name="ImportedCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Imported" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                <StackPanel><TextBlock x:Name="SkippedCountText" Text="0" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Skipped / failed" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,14">
                    <StackPanel>
                        <TextBlock Text="Import preview" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Only valid rows will be imported. Select a row to read its exact validation result."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="ImportButton"
                            Content="Import valid rows"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="ImportButton_Click" />
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="PreviewGrid" SelectionMode="Single" />
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#EEEEFF" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Choose a file to preview" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,5" />
                        <TextBlock Text="Supported formats: .xlsx and UTF-8 tab-separated .txt" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="BusyOverlay" Grid.RowSpan="4" Background="#BFFFFFFF" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Reading and validating file…" FontWeight="SemiBold" />
                        <TextBlock Text="Large files may take a moment." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
